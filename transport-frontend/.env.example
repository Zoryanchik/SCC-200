# Copy this file to .env and adjust as needed
# VITE_API_BASE_URL — base URL for the transport backend API
# Local development (default):
VITE_API_BASE_URL=http://localhost:5050
# University production server:
# VITE_API_BASE_URL=https://transport.scc.lancs.ac.uk

# Optional: call OSRM directly from the browser (not recommended when OSRM is
# only reachable via docker-compose hostnames).
# If unset, the frontend will use the backend proxy endpoint: GET /osrm/route
#
# VITE_OSRM_BASE=http://127.0.0.1:5012
